# Local development defaults — copy to .env and fill in OPENAI_API_KEY.
# In production (Render Blueprint) all of these are set by render.yaml.
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://interviewer:interviewer@db:5432/interviewer
# Required for real interviews. Without it the engine still works via its
# deterministic fallback (pack questions verbatim, no adaptive follow-ups).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
